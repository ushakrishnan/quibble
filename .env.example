# Copy to .env and edit. CLI flags (e.g. --device cuda) override these.

# cpu | cuda | auto.  "cuda" fails loudly if CUDA is unavailable (no silent CPU fallback,
# so a benchmark never claims GPU numbers it did not produce).
QUIBBLE_DEVICE=auto

QUIBBLE_PREPROCESS=ordinal      # ordinal | native (native categoricals where a backend supports them)
QUIBBLE_SPLIT_SEED=0            # fixed split: every backend sees the same train/test rows
QUIBBLE_CV=holdout              # holdout | KxR (e.g. 5x2 = 10 splits). Use CV for the analysis tools
QUIBBLE_CV_SEED=0
QUIBBLE_BOOT=500                # bootstrap resamples for confidence intervals
QUIBBLE_MODEL_SEEDS=0,1,2       # model randomness, varied per run
QUIBBLE_THREADS=0               # 0 = all cores (or cores/jobs when jobs > 1)
QUIBBLE_JOBS=1                  # parallel CPU runs. Use 1 for the final timed benchmark
QUIBBLE_TIMEOUT_S=900           # per-run timeout in sweeps, 0 = none
QUIBBLE_SINGLE_N=30             # rows used for single-row latency

QUIBBLE_AG_PRESET=medium_quality
QUIBBLE_AG_TIME_LIMIT=120
QUIBBLE_TABPFN_MAX_ROWS=        # harness policy: blank = 10000 on cuda, 1000 on cpu; verify library limits
QUIBBLE_TABICL_ALLOW_DOWNLOAD=0 # 1 explicitly permits pinned TabICLv2 checkpoint downloads after terms review
QUIBBLE_TABFM_N_ESTIMATORS=4
QUIBBLE_KUMO_SIZE=small         # small | medium | large
QUIBBLE_KUMO_N_ESTIMATORS=4
QUIBBLE_KEEP_MODELS=0           # 1 retains fitted tree/AutoGluon models; not foundation estimators

QUIBBLE_OUT_DIR=results
QUIBBLE_CACHE_DIR=.cache        # relative paths resolve from the project root, not the shell directory
QUIBBLE_SKLEARN_CACHE_DIR=      # blank follows QUIBBLE_CACHE_DIR/sklearn
QUIBBLE_HF_CACHE_DIR=           # blank follows QUIBBLE_CACHE_DIR/huggingface
QUIBBLE_TRANSFORMERS_CACHE_DIR= # blank shares the Hugging Face hub cache, avoiding duplicate weights
QUIBBLE_DATA_HOME=              # blank follows QUIBBLE_CACHE_DIR/openml; explicit paths override it
QUIBBLE_DATA_DIR=data           # local dataset folders; relative paths resolve from the project root

# Optional planner: any compatible Chat Completions + JSON-object endpoint.
# Used only after explicit scenario-planning consent. No dataset rows are sent.
LLM_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=
LLM_AUTH_MODE=api_key          # api_key | aad | none (none is loopback-only)
LLM_API_KEY=                   # provider-specific; never put it in the browser
LLM_PROVIDER_NAME=             # optional display label
# Azure example: LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# Set LLM_MODEL to its deployment name and choose aad or api_key.
# Local example: LLM_BASE_URL=http://127.0.0.1:11434/v1/ with LLM_AUTH_MODE=none
LLM_AAD_CREDENTIAL=cli          # cli uses az login; default uses DefaultAzureCredential
LLM_TOKEN_SCOPE=https://ai.azure.com/.default
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=          # optional context selection by quibble auth
# Standard OPENAI_BASE_URL/OPENAI_MODEL/OPENAI_API_KEY are supported as aliases.
# Older FOUNDRY_PROJECT_ENDPOINT/AZURE_AI_MODEL_DEPLOYMENT_NAME/FOUNDRY_AUTH_MODE/
# FOUNDRY_API_KEY/FOUNDRY_AAD_CREDENTIAL/AZURE_OPENAI_SCOPE settings remain supported
# when no generic/OpenAI endpoint is set. Prefer the provider-neutral names above.